# URL ของ FastAPI backend — ต้องตรงกับ port ที่รัน uvicorn
# dev: uvicorn app.main:app --port 8011
NEXT_PUBLIC_API_URL=http://localhost:8011

# ชื่อ App — อาจต่างกันตาม environment (dev / staging / prod)
NEXT_PUBLIC_APP_NAME=FutureSign Multi-App

# Public API URL สำหรับ LIFF page (ต้องเป็น URL ที่ LINE เข้าถึงได้จากนอก เช่น ngrok URL)
# ใช้เฉพาะ local dev ที่ต้องการทดสอบ LINE Webhook ผ่าน tunnel
# NEXT_PUBLIC_LIFF_API_URL=https://your-subdomain.ngrok-free.app
