# URL ที่ฝั่ง server ของ frontend ใช้ต่อกับ FastAPI backend (เป็นปลายทางของ /api/* rewrite ด้วย)
# dev บนเครื่องเดียว: uvicorn app.main:app --port 8019
# Docker compose: ชื่อ service + port ใน container → http://backend:8000 (เป็นค่า default ของ compose แล้ว)
# เบราว์เซอร์ไม่ใช้ค่านี้ — หน้าเว็บเรียก origin ของตัวเองแล้วให้ Next server proxy ไปให้
NEXT_PUBLIC_API_URL=http://localhost:8019

# ชื่อ App ที่แสดงบน browser tab — เป็นค่าเริ่มต้นก่อนที่ชื่อจริงจาก app_settings.app_name จะโหลดเสร็จ
# (ชื่อที่ผู้ใช้เห็นจริงแก้ที่ Admin UI → Settings) ค่า default ในโค้ดคือ WorkDee
NEXT_PUBLIC_APP_NAME=WorkDee

# Public URL ของ frontend สำหรับทดสอบ LIFF/Webhook ผ่าน tunnel (เฉพาะ local dev)
# ใช้สร้าง allowedDevOrigins ของ `next dev` — host ต้องตรงกับที่มือถือ/LINE เปิดจริง (ไม่มีผลกับ production build)
# NEXT_PUBLIC_LIFF_API_URL=https://<your-public-frontend-url>

# host/IP เพิ่มเติมที่อนุญาตให้ `next dev` ให้บริการ /_next/* — ใช้เฉพาะตอน dev (ไม่มีผลกับ production build)
# ถ้าไม่ตั้งหรือเว้นว่าง พฤติกรรมจะเหมือนเดิมทุกอย่าง; คั่นหลายค่าด้วยจุลภาค; ค่าจริงเก็บใน .env.local (ไม่ขึ้น git)
# DEV_ALLOWED_ORIGINS=<tailnet-ip-or-host>,<another-host>

# LIFF ID สำรองของหน้า "QR Code" ใน dashboard/line — ค่าจริงอ่านจาก Admin UI → Settings
# ใช้เฉพาะเมื่อยังไม่ได้ตั้งค่าใน DB; รูปแบบ <channelId>-<suffix> (ค่านี้เป็นตัวอย่าง ไม่ใช่ค่าจริงของระบบนี้)
# NEXT_PUBLIC_LIFF_ID=2000000000-abcdefgh
