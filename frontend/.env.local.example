# URL ของ FastAPI backend — ต้องตรงกับ port ที่รัน uvicorn
# dev: uvicorn app.main:app --port 8019
NEXT_PUBLIC_API_URL=http://localhost:8019

# ชื่อ App — อาจต่างกันตาม environment (dev / staging / prod)
NEXT_PUBLIC_APP_NAME=FutureSign Multi-App

# Public URL สำหรับ LIFF page (ต้องเป็น URL ที่ LINE เข้าถึงได้จากอินเทอร์เน็ต)
# ใช้เฉพาะ local dev ที่ทดสอบ LINE Webhook ผ่าน tunnel — host ต้องตรงกับที่มือถือ/LINE เปิดจริง
# NEXT_PUBLIC_LIFF_API_URL=https://<your-public-frontend-url>
