# FastAPI's own name (the API title and the /health answer). Code default: WorkDee.
# What people actually see in the web UI comes from `app_settings.app_name` (Admin UI →
# Settings), not from this value.
APP_NAME="WorkDee"
# A deployment can pick its PostgreSQL schema through the URL itself — the parameter is percent-encoded and the
# schema must already exist:
# DATABASE_URL="postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME?options=-csearch_path%3D<your_schema>"
# Without the parameter the connection uses the server's own default search_path (usually `public`).
DATABASE_URL="postgresql+asyncpg://USER:PASSWORD@HOST:5432/DB_NAME"
# Database index 0 is the session store on a dev machine (the live Redis). Test suites and throwaway instances must
# use another index, e.g. `/5`, so a test run can never touch a live session:
# REDIS_URL="redis://localhost:6379/5"
REDIS_URL="redis://localhost:6379/0"

# Core-API Integration
CORE_API_URL="https://core-api.your-domain.co.th/"
CORE_API_KEY="fsc_live_YOUR_KEY_HERE"
# No ORACLE_* block is needed: WorkDee never connects to Oracle. All employee master data (including
# department/division) comes through Core-API. Any ORACLE_* keys left in this file are ignored
# (`config.py` uses extra="ignore"), so they cannot stop the app from starting.

# JWT
SECRET_KEY="GENERATE_WITH: openssl rand -base64 32"
ALGORITHM="HS256"

# CORS — comma-separated list of allowed frontend origins
# Code default: http://localhost:3019,http://127.0.0.1:3019 (the value below is the production shape)
CORS_ORIGINS="http://localhost:3019,https://your-production-domain.com"

# Cookie Security
# COOKIE_SECURE=False  → HTTP allowed (dev)
# COOKIE_SECURE=True   → HTTPS only (production)
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"

# Environment name — "development" locally, "production" when deployed.
# Informational only (no code path branches on it as of 2026-09-29).
APP_ENV="development"

# Token TTL (seconds)
# ACCESS_TOKEN_EXPIRE_SECONDS (re-checked by task 041): **no application code reads it**. Core-API
# decides the real life of an access token (measured at 1800 s) and the WorkDee cookie's life is
# SESSION_MAX_AGE_MINUTES. It is kept only because the in-process suites in `.scratch/` use it as the
# fake-token TTL (verify023, verify028, probe028_sub_trust, deploy033_effective) — see
# docs/DEPLOY_GUIDE.md §13 and §14.6.
ACCESS_TOKEN_EXPIRE_SECONDS=900
# Life of the refresh cookie, in seconds (7 days).
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# ── Session lifetime rules (task 028) ──────────────────────────────────────────
# One sign-in is renewed silently at most SESSION_MAX_RENEWALS times and never lasts longer than
# SESSION_MAX_AGE_MINUTES in total. After either limit the session really ends: 401, both cookies
# cleared, every Redis key of that session removed, and the browser lands on /login?expired=1.
# These two numbers are the only knobs. See docs/DEPLOY_GUIDE.md §13.
SESSION_MAX_RENEWALS=3
SESSION_MAX_AGE_MINUTES=60

# ── Security / operations flags (task 019) ─────────────────────────────────────
# Both default to OFF and only these values count as "on": 1, true, yes, on, t, y
# (case-insensitive). Any other value — including a typo — is treated as OFF, so a mistake here
# can never silently switch something on.

# Serve the interactive API docs (/docs, /redoc, /openapi.json). Leave off in production; turn on
# only while developing.
ENABLE_API_DOCS=false

# Log every SQL statement the backend runs (useful when debugging, noisy and slower otherwise).
SQL_ECHO=false

# ── Photo storage (task 020) ───────────────────────────────────────────────────
# Folder that holds check-in photos. A relative path is resolved against the backend folder, so the
# default lives inside the app tree. On Ubuntu the usual setup is a mounted NAS path (absolute, e.g.
# /mnt/nas/workdee/photos) — the service user must be able to write there. Never a Windows drive
# letter on a service machine. Infrastructure setting: not editable from the admin web UI.
PHOTO_STORAGE_DIR="storage/checkin_photos"

# Largest accepted photo, in bytes (default 5 MB). A value that is not a positive whole number falls
# back to the default and logs one warning instead of stopping the app.
PHOTO_MAX_BYTES=5242880

# ── LINE Messaging API hosts (task 025) ────────────────────────────────────────
# Two LINE hosts are used: the normal API host and the data host that accepts the rich-menu picture
# upload. They exist as settings so a test can point them at a local stub; production leaves them at
# LINE's real hosts (which is what the defaults below are).
LINE_API_BASE="https://api.line.me"
LINE_DATA_API_BASE="https://api-data.line.me"

# LINE OA Configuration (Optional — can be configured via Admin Dashboard UI instead)
# LINE_CHANNEL_ACCESS_TOKEN="your_long_token_here"
# LINE_CHANNEL_SECRET="your_channel_secret_here"
# LINE_LIFF_ID="your_liff_id_here"
