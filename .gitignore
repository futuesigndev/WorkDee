*.pem
*.key
*.crt
*.pub

# --- IDE & Editors ---
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp
*.swo
*~
.project
.classpath
.settings/

# --- Python Environment & Compiled Code ---
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/
env/
ENV/
*.egg-info/
dist/
build/
.tox/
.coverage
.cache
htmlcov/

