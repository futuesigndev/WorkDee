node_modules/
.next/
out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# --- Environment Configuration (Secrets) ---
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
backend/.env
frontend/.env.local

